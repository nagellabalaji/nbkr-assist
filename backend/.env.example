FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database Configuration
# Format: mysql+pymysql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:@localhost/college_complaints

# AI Configuration (Optional)
# If provided, the system will use Google Gemini API for classifications, prioritizations, and chatbot messages.
# If omitted or empty, the backend will fall back to local rule-based NLP algorithms.
GEMINI_API_KEY=

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16 MB maximum upload file size
UPLOAD_FOLDER=uploads

# Email Delivery Configuration (Resend or SMTP)
# 1. Resend API setup
EMAIL_API_KEY=
EMAIL_FROM=noreply@campusfix.ai

# 2. SMTP Setup (Alternative)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# 3. OTP Configuration thresholds
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60

# Google OAuth 2.0 Credentials
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
