# ==============================================================================
# NBKR Assist - Environment Configuration Template
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=false
PORT=10000

# Security Keys (Generate strong random secrets for production)
SECRET_KEY=change-this-in-production-to-a-secure-random-key
JWT_SECRET_KEY=change-this-in-production-to-a-secure-jwt-key

# Allowed CORS Origins (comma-separated list of frontends)
# Example: https://nagellabalaji.github.io,http://localhost:5173
CORS_ORIGINS=https://nagellabalaji.github.io,http://localhost:5173

# Database Connection URL
# MySQL: mysql+pymysql://username:password@host:port/database_name
# PostgreSQL (Render / Supabase / Neon): postgresql://username:password@host:port/database_name
DATABASE_URL=mysql+pymysql://root:@localhost/college_complaints

# Google Gemini AI API Key (Optional: falls back to rule-based algorithms if empty)
GEMINI_API_KEY=

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Email Service Configuration
# 1. Resend API
EMAIL_API_KEY=
EMAIL_FROM=noreply@campusfix.ai

# 2. SMTP (e.g. Gmail SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# OTP Thresholds
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60

# Google OAuth 2.0 Credentials (for Single Sign-On)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
